rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'sarfarazmech00@gmail.com'
      );
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Paper Trades (Simulation)
    match /paperTrades/{tradeId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Payment and Activation requests submitted by users
    match /activationRequests/{requestId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }

    // Activation Codes Vault
    match /activationCodes/{codeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRedeemed', 'redeemedAt', 'redeemedByUid']) &&
        resource.data.isRedeemed == false &&
        request.resource.data.isRedeemed == true
      );
    }

    // Influencer Commission Ledger (20% commission, 7-day hold)
    match /commissions/{commissionId} {
      allow read: if isAuthenticated() && (
        resource.data.influencerUid == request.auth.uid || 
        isAdmin()
      );
      allow write: if isAdmin();
    }
  }
}
